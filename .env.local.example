# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://sua-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# OpenRouter (IA)
OPENROUTER_API_KEY=sua-chave-openrouter-aqui
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Supabase (somente servidor — NUNCA use NEXT_PUBLIC_ aqui)
# Painel Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Cakto (pagamentos)
# Links das ofertas: Painel Cakto → Produto → Ofertas → copiar link
CAKTO_CHECKOUT_MENSAL_URL=https://pay.cakto.com.br/xxxxxxx
CAKTO_CHECKOUT_ANUAL_URL=https://pay.cakto.com.br/yyyyyyy
# Secret do webhook (Painel Cakto → Integrações → Webhooks)
CAKTO_WEBHOOK_SECRET=seu-secret-do-webhook-aqui

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FATURION
